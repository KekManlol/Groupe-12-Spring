### CREATE ONE NON-EXISTING USER
POST {{authentication_url}}/newUser
Content-Type: application/json

{
  "username": "newUser",
  "password": "blablabla"
}

### CREATE ONE EXISTING USER
POST {{authentication_url}}/bob
Content-Type: application/json

{
  "username": "bob",
  "password": "password"
}

### CONNECT ONE EXISTING USER
POST {{authentication_url}}/connect
Content-Type: application/json

{
  "username": "newUser",
  "password": "blablabla"
}

### CONNECT ONE NON-EXISTING USER
POST {{authentication_url}}/connect
Content-Type: application/json

{
  "username": "nonExistingUser",
  "password": "blablabla"
}


### VERIFY
POST {{authentication_url}}/verify
Content-Type: text/plain

eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzUxMiJ9.eyJpc3MiOiJhdXRoMCIsInVzZXJuYW1lIjoidGVzdCJ9.ZnvsrW07eomBqBgqqThoYO6jizwJhV-t0f-aHcKQpHQWTOhdpC7F9J2C0woRFl7Ue1b2U7r80NojqCss5SOygg

### DELETE ONE EXISTING USER
DELETE {{authentication_url}}/newUser

### DELETE ONE NON-EXISTING USER
DELETE {{authentication_url}}/nonExisting

### UPDATE ONE EXISTING USER
PUT {{authentication_url}}/newUser
Content-Type: application/json

{
  "username": "newUser",
  "password": "password"
}

### UPDATE ONE EXISTING USER
PUT {{authentication_url}}/nonExisting
Content-Type: application/json

{
  "username": "nonExisting",
  "password": "password"
}

### UPDATE ONE EXISTING USER WITH WRONG PATH
PUT {{authentication_url}}/test5
Content-Type: application/json

{
  "username": "newUser",
  "password": "password"
}